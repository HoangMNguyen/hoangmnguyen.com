terraform {
  required_version = ">= 1.10"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-2"
  default_tags {
    tags = { Project = "focus-bank", ManagedBy = "terraform" }
  }
}

data "aws_region" "current" {}
